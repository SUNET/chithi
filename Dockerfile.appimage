# Portable AppImage build environment for the Tauri app.
# Debian 12 provides the oldest supported WebKitGTK 4.1 baseline, keeping the
# resulting glibc requirement lower than an AppImage built on rolling Arch.
ARG BASE_IMAGE=debian:12
FROM ${BASE_IMAGE}

ARG PKG_VERSION=""

ENV DEBIAN_FRONTEND=noninteractive
ENV CI=true
# AppImage helper tools must self-extract in unprivileged Docker builds where
# FUSE is unavailable.
ENV APPIMAGE_EXTRACT_AND_RUN=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    libwebkit2gtk-4.1-dev \
    libssl-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    libgtk-3-dev \
    libpango1.0-dev \
    libgdk-pixbuf-2.0-dev \
    libsoup-3.0-dev \
    libjavascriptcoregtk-4.1-dev \
    libpcsclite-dev \
    build-essential \
    pkg-config \
    curl \
    file \
    ca-certificates \
    jq \
    patchelf \
    xdg-utils \
    libfuse2 \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 22 and a current Rust toolchain; Debian 12's packaged
# versions are older than the project's supported build toolchain.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

RUN npm install -g pnpm@10.27.0

WORKDIR /app
COPY . .

RUN if [ -n "$PKG_VERSION" ]; then \
        jq --arg v "$PKG_VERSION" '.version = $v' src-tauri/tauri.conf.json > tmp.json && \
        mv tmp.json src-tauri/tauri.conf.json; \
    fi

RUN pnpm install --frozen-lockfile
RUN pnpm tauri build --bundles appimage

CMD ["ls", "-la", "src-tauri/target/release/bundle/appimage/"]
